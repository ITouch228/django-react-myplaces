# ============================================================
# Базовый этап (общие зависимости)
# ============================================================
FROM node:20-alpine AS base

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund


# ============================================================
# Этап разработки (dev) — горячая перезагрузка
# ============================================================
FROM base AS dev

COPY . .

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]


# ============================================================
# Этап сборки (builder) — собирает статику
# ============================================================
FROM base AS builder

COPY . .

RUN npm run build


# ============================================================
# Этап продакшена (prod) — только статика + сервер
# ============================================================
FROM node:20-alpine AS prod

WORKDIR /app

COPY --from=builder /app/dist ./dist

RUN npm install -g serve

CMD ["serve", "-s", "dist", "-l", "5173"]