# Normalize repository text consistently across Windows and Linux.
# Executable files must always be checked out with LF (including on Windows).
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
Dockerfile text eol=lf
**/Dockerfile text eol=lf
Jenkinsfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf

# Native Windows scripts retain Windows line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets must not be rewritten.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.db binary
*.sqlite3 binary
