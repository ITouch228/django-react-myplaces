# ============================================
# Backend env (скопируй в .env и заполни значения)
# ============================================

# Обязательное. Сгенерируй: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True только в разработке. На проде всегда False.
DEBUG=True

# Список хостов через запятую.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Разрешённые CORS-источники через запятую.
# Для разработки обычно фронт на 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
